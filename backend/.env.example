# Required. No fallback exists — the server refuses to start without this.
# Local dev:  mongodb://localhost:27017/movie-checklist
# Production: your MongoDB Atlas (or other hosted) connection string.
MONGODB_URI=

# Optional. Defaults to 4000 locally. Render sets this automatically in production.
PORT=4000

# Required in production. The exact origin (scheme + host, no trailing slash) of the
# deployed frontend, used for CORS. Defaults to http://localhost:3000 when unset,
# which is only correct for local development.
FRONTEND_URL=http://localhost:3000

# Optional. When set, newly added movies automatically get a poster fetched
# from TMDB in the background. Get a free API key (v3 auth) at
# https://www.themoviedb.org/settings/api — the app works perfectly without one.
TMDB_API_KEY=
